# Required in production — long random string for JWT signing
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: JWT lifetime in days (default 14)
JWT_DAYS=14

# Comma-separated extra origins allowed for CORS (your live site URL)
# Example: https://billing.yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# --- Billing / Razorpay ---
# Leave empty for local mock checkout (simulates successful payment).
# For live payments, create keys at https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional webhook secret for payment.captured
RAZORPAY_WEBHOOK_SECRET=
# Force mock even if keys exist: PAYMENT_MODE=mock
# PAYMENT_MODE=mock

# Optional absolute path for extra backup copies
# BACKUP_FOLDER=D:\Backups

# Optional custom SQLite path (default: ./data/gst_multitenant.db)
# DATABASE_PATH=./data/gst_multitenant.db

NODE_ENV=production
