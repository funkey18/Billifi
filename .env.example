# Required in production — long random string for JWT signing
JWT_SECRET=change-me-to-a-long-random-secret

# Optional: JWT lifetime in days (default 14)
JWT_DAYS=14

# Comma-separated extra origins allowed for CORS (your live site URL)
# Example: https://billing.yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Public URL of this app (used as Hyperswitch return_url)
# APP_PUBLIC_URL=http://localhost:5173

# --- Billing ---
# Priority: PAYMENT_MODE=mock → Hyperswitch keys → Razorpay keys → mock
# Force mock: PAYMENT_MODE=mock

# Razorpay (direct checkout). Create keys at https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Hyperswitch (https://github.com/juspay/hyperswitch) — preferred when set
# Hosted sandbox: https://app.hyperswitch.io  |  Self-host: see docs/HYPERSWITCH.md
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_API_KEY=
HYPERSWITCH_PUBLISHABLE_KEY=
# HYPERSWITCH_PROFILE_ID=
# HYPERSWITCH_WEBHOOK_SECRET=
# HYPERSWITCH_SDK_URL=https://beta.hyperswitch.io/v1/HyperLoader.js

# Optional absolute path for extra backup copies
# BACKUP_FOLDER=D:\Backups

# Optional custom SQLite path (default: ./data/gst_multitenant.db)
# DATABASE_PATH=./data/gst_multitenant.db

# Cloud persistent volume (REQUIRED on Render/Railway so data survives redeploys)
# Mount a disk/volume, then point both here:
# DATA_DIR=/var/data
# DATABASE_PATH=/var/data/gst_multitenant.db
# HOST=0.0.0.0

NODE_ENV=production
